# Cloudinary Configuration
# Lấy thông tin này từ Cloudinary Dashboard: https://cloudinary.com/console
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name_here
VITE_CLOUDINARY_API_KEY=your_api_key_here
VITE_CLOUDINARY_API_SECRET=your_api_secret_here
VITE_CLOUDINARY_UNSIGNED_PRESET=your_unsigned_preset_here

# Backend API Configuration
VITE_API_BASE_URL=http://localhost:8080/api

# Application Configuration
VITE_APP_NAME=TutorMatch
VITE_APP_VERSION=1.0.0

# Hướng dẫn cấu hình:
# 1. Copy file này thành .env
# 2. Thay thế các giá trị your_*_here bằng thông tin thực tế từ Cloudinary
# 3. Để tạo unsigned preset:
#    - Vào Cloudinary Dashboard > Settings > Upload
#    - Tạo upload preset mới
#    - Đặt Signing Mode = "Unsigned"
#    - Copy preset name vào VITE_CLOUDINARY_UNSIGNED_PRESET
